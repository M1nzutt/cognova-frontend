{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build frontend",
			"type": "shell",
			"command": "npm",
			"windows": {
				"command": "npm.cmd"
			},
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Preview frontend",
			"type": "shell",
			"command": "npm",
			"windows": { "command": "npm.cmd" },
			"args": [
				"run",
				"preview",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"4173",
				"--strictPort"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
